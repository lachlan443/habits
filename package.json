{
  "name": "habits-tracker",
  "version": "1.0.0",
  "description": "Habit tracking application inspired by everyday.app",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npm install && npm install --prefix client && concurrently -n backend,frontend -c blue,green \"node --watch src/server.js\" \"npm run dev --prefix client\"",
    "dev:backend": "npm install && node --watch src/server.js",
    "test": "jest"
  },
  "keywords": [
    "habits",
    "tracker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-sqlite3": "^0.9.16",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^30.4.2"
  },
  "overrides": {
    "sqlite3": "^6.0.1"
  }
}
